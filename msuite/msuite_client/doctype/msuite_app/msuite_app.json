{
    "actions": [],
    "autoname": "field:app_name",
    "creation": "2026-04-05 00:00:00",
    "doctype": "DocType",
    "engine": "InnoDB",
    "field_order": [
        "details_section", "app_name", "platform", "is_active",
        "credentials_section", "app_id", "app_secret",
        "whatsapp_section", "config_id", "allow_coexistence",
        "oauth_section", "redirect_uri", "developer_token",
        "ai_calling_section", "ai_backend_url",
        "webhook_section", "webhook_verify_token", "webhook_url",
        "deauthorize_section", "deauthorize_callback_url"
    ],
    "fields": [
        {
            "fieldname": "details_section",
            "fieldtype": "Section Break",
            "label": "App Details"
        },
        {
            "fieldname": "app_name",
            "fieldtype": "Data",
            "label": "App Name",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1,
            "bold": 1
        },
        {
            "fieldname": "platform",
            "fieldtype": "Select",
            "label": "Platform",
            "options": "Meta WhatsApp\nMeta Social\nMeta Catalogue\nGoogle\nTikTok\nLinkedIn\nTwitter\nAI Calling\nMillionVerifier",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "is_active",
            "fieldtype": "Check",
            "label": "Is Active",
            "default": "1",
            "in_list_view": 1
        },
        {
            "fieldname": "credentials_section",
            "fieldtype": "Section Break",
            "label": "Credentials",
            "depends_on": "eval:doc.platform!='AI Calling'"
        },
        {
            "fieldname": "app_id",
            "fieldtype": "Data",
            "label": "App ID",
            "mandatory_depends_on": "eval:doc.platform!='AI Calling' && doc.platform!='MillionVerifier'",
            "description": "Platform App/Client ID"
        },
        {
            "fieldname": "app_secret",
            "fieldtype": "Password",
            "label": "App Secret",
            "mandatory_depends_on": "eval:doc.platform!='AI Calling'",
            "description": "Encrypted. Never shared with client instances."
        },
        {
            "fieldname": "whatsapp_section",
            "fieldtype": "Section Break",
            "label": "WhatsApp Embedded Signup",
            "depends_on": "eval:doc.platform=='Meta WhatsApp'"
        },
        {
            "fieldname": "config_id",
            "fieldtype": "Data",
            "label": "Embedded Signup Config ID",
            "description": "From Meta Business Manager → WhatsApp → Embedded Signup",
            "mandatory_depends_on": "eval:doc.platform=='Meta WhatsApp'"
        },
        {
            "fieldname": "allow_coexistence",
            "fieldtype": "Check",
            "label": "Allow Coexistence Onboarding",
            "default": "1",
            "description": "Allow customers who already use WhatsApp Business App to also connect via Cloud API (same number, synced chats)"
        },
        {
            "fieldname": "oauth_section",
            "fieldtype": "Section Break",
            "label": "OAuth",
            "depends_on": "eval:doc.platform!='Meta WhatsApp'"
        },
        {
            "fieldname": "redirect_uri",
            "fieldtype": "Data",
            "label": "OAuth Redirect URI",
            "description": "Redirect URI registered with the platform"
        },
        {
            "fieldname": "developer_token",
            "fieldtype": "Password",
            "label": "Google Ads Developer Token",
            "depends_on": "eval:doc.platform=='Google'",
            "description": "From the Google Ads API Center. Required in addition to app_id/app_secret for any Google Ads (not plain Google OAuth) integration — Google has no per-account equivalent, it's account-independent."
        },
        {
            "fieldname": "ai_calling_section",
            "fieldtype": "Section Break",
            "label": "AI Calling Backend",
            "depends_on": "eval:doc.platform=='AI Calling'"
        },
        {
            "fieldname": "ai_backend_url",
            "fieldtype": "Data",
            "label": "AI Backend URL",
            "mandatory_depends_on": "eval:doc.platform=='AI Calling'",
            "description": "Base URL of the single shared AWS FastAPI AI Calling backend used by every client (e.g. https://ai-calling.example.com). Universal — every Active MSuite Client receives this same value when pushed."
        },
        {
            "fieldname": "webhook_section",
            "fieldtype": "Section Break",
            "label": "Webhook",
            "depends_on": "eval:doc.platform!='AI Calling'"
        },
        {
            "fieldname": "webhook_verify_token",
            "fieldtype": "Data",
            "label": "Webhook Verify Token",
            "description": "Token the platform sends to verify your webhook"
        },
        {
            "fieldname": "webhook_url",
            "fieldtype": "Data",
            "label": "Webhook URL",
            "description": "Auto-generated from site URL. Edit if using ngrok or custom domain."
        },
        {
            "fieldname": "deauthorize_section",
            "fieldtype": "Section Break",
            "label": "Deauthorize Callback",
            "depends_on": "eval:doc.platform!='AI Calling'",
            "description": "Set this URL in Meta App Dashboard → Settings → Advanced → Deauthorize Callback URL"
        },
        {
            "fieldname": "deauthorize_callback_url",
            "fieldtype": "Data",
            "label": "Deauthorize Callback URL",
            "description": "Auto-generated from site URL. Edit if using ngrok or custom domain."
        }
    ],
