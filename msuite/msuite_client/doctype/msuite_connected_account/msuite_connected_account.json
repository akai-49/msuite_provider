  {
   "fieldname": "platform",
   "fieldtype": "Select",
   "label": "Platform",
   "options": "WhatsApp\nFacebook\nInstagram\nMeta Ads\nMeta Catalogue\nYouTube\nGmail\nGoogle Ads\nTikTok\nLinkedIn\nLinkedIn Page\nLinkedIn Profile\nTwitter",
