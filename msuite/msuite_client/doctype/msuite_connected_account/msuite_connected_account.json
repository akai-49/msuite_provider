  {
   "fieldname": "cb_account",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nExpired\nDisconnected\nRevoked",
   "default": "Active",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "needs_reauth",
   "fieldtype": "Check",
   "label": "Needs Re-auth",
   "default": 0,
   "read_only": 1,
   "description": "Set when a refresh attempt failed unrecoverably. Customer site shows a Reconnect prompt."
  },
  {
   "fieldname": "connected_via",
   "fieldtype": "Select",
   "label": "Connected Via",
   "options": "Provider\nClient",
   "default": "Provider",
   "read_only": 1
  },
  {
   "fieldname": "msuite_app",
   "fieldtype": "Link",
   "label": "MSuite App",
   "options": "MSuite App",
   "read_only": 1
  },
  {
   "fieldname": "token_section",
   "fieldtype": "Section Break",
   "label": "Token",
   "hidden": 1
  },
  {
   "fieldname": "access_token",
   "fieldtype": "Password",
   "label": "Access Token",
   "description": "Encrypted. Short-lived for OAuth-refresh platforms (Google/Twitter/TikTok), long-lived for Meta."
  },
  {
   "fieldname": "refresh_token",
   "fieldtype": "Password",
   "label": "Refresh Token",
   "description": "Encrypted. Used by Google/Twitter/TikTok/LinkedIn-new to mint a fresh access_token. Null for Meta long-lived (extended in place via fb_exchange_token)."
  },
  {
   "fieldname": "token_type",
   "fieldtype": "Select",
   "label": "Token Type",
   "options": "\nSystem User\nPage Token\nUser Token\nOAuth Token",
   "read_only": 1
  },
  {
   "fieldname": "token_expiry",
   "fieldtype": "Datetime",
   "label": "Token Expiry",
   "read_only": 1,
   "description": "Null = never expires"
  },
  {
   "fieldname": "timestamps_section",
   "fieldtype": "Section Break",
   "label": "Timestamps",
   "collapsible": 1
  },
  {
   "fieldname": "connected_at",
   "fieldtype": "Datetime",
   "label": "Connected At",
   "read_only": 1
  },
  {
   "fieldname": "last_refreshed",
   "fieldtype": "Datetime",
   "label": "Last Refreshed",
   "read_only": 1,
   "description": "Last SUCCESSFUL refresh. Used by the daily cron to skip recently-refreshed accounts."
  },
  {
   "fieldname": "last_refresh_attempt_at",
   "fieldtype": "Datetime",
   "label": "Last Refresh Attempt",
   "read_only": 1,
   "description": "Set on EVERY attempt (success or failure) so we don't hammer the provider after a known-broken token."
  },
  {
   "fieldname": "last_refresh_error",
   "fieldtype": "Small Text",
   "label": "Last Refresh Error",
   "read_only": 1,
   "description": "Diagnostic for the most recent failed refresh."
  },
  {
   "fieldname": "webhook_section",
   "fieldtype": "Section Break",
   "label": "Webhook Subscription",
   "depends_on": "eval:doc.platform === 'Facebook' || doc.platform === 'Instagram'"
  },
  {
   "fieldname": "subscribed_fields",
   "fieldtype": "Small Text",
   "label": "Subscribed Webhook Fields",
   "read_only": 1,
   "description": "Comma-separated Meta webhook fields the provider subscribed this Page to via /subscribed_apps. Empty = never subscribed (no realtime events will arrive)."
  },
  {
   "fieldname": "subscribed_at",
   "fieldtype": "Datetime",
   "label": "Last Subscribed At",
   "read_only": 1
  },
  {
   "fieldname": "last_subscription_error",
   "fieldtype": "Small Text",
   "label": "Last Subscription Error",
   "read_only": 1,
   "description": "Diagnostic for the most recent failed /subscribed_apps call. Cleared on the next success."
  },
  {
   "fieldname": "last_inbound_event_at",
   "fieldtype": "Datetime",
   "label": "Last Inbound Event At",
   "read_only": 1
  }
