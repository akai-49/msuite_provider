   "in_list_view": 1,
   "description": "The product/service (not parent company)"
  },
  {
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "Display Name",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "account_id",
   "fieldtype": "Data",
   "label": "Account ID",
   "reqd": 1,
   "description": "waba_id, page_id, ig_user_id, ad_account_id, etc."
